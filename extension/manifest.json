{
  "manifest_version": 3,
  "name": "Coffre-Fort",
  "version": "1.3.0",
  "description": "Remplit vos identifiants depuis l'application Coffre-Fort, uniquement sur le bon site et à votre demande.",
  "key": "",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Coffre-Fort",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting",
    "storage"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Ouvrir Coffre-Fort pour remplir un identifiant"
    }
  }
}
